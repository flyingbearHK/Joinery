{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Joinery",
  "version": "0.1.0",
  "identifier": "app.joinery.modeler",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Joinery",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": null,
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Logical data modeling and ER diagram design",
    "longDescription": "Joinery is a standalone logical data modeling application with Crow's Foot diagrams, multiple subject views, validation, and vector export.",
    "licenseFile": "../LICENSE",
    "fileAssociations": [
      {
        "ext": ["joinery"],
        "name": "Joinery logical model",
        "description": "Joinery logical data model",
        "role": "Editor",
        "mimeType": "application/vnd.joinery.model+json",
        "rank": "Owner",
        "exportedType": {
          "identifier": "app.joinery.modeler.document",
          "conformsTo": ["public.json", "public.data"]
        }
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
